(ns pi.phase-test
  "The phase table as executable tests. The single invariant this repo
  cannot regress on: `:actuation/execute-payment`/`:actuation/remit-
  payout` must NEVER be a member of any phase's `:auto` set."
  (:require [kotoba.test :refer [deftest is testing]]
            [pi.phase :as phase]))

(def actuation-ops
  "Every op that touches a real payment execution/remittance payout. This
  set is the single source of truth for `actuation-never-auto-at-any-
  phase` below -- add a new actuation op here, not just in `pi.phase`, so
  a forgotten :auto exclusion fails loudly instead of silently."
  #{:actuation/execute-payment :actuation/remit-payout})

(deftest actuation-never-auto-at-any-phase
  (testing "structural invariant: no phase, now or in future entries, auto-commits a real actuation op"
    (doseq [[n {:keys [auto]}] phase/phases
            op actuation-ops]
      (is (not (contains? auto op))
          (str "phase " n " must not auto-commit " op)))))

(deftest phase-0-is-fully-read-only
  (is (empty? (:writes (get phase/phases 0)))))

(deftest phase-3-auto-commits-only-intake
  (is (= #{:account/intake} (:auto (get phase/phases 3)))))

(deftest gate-hold-always-wins
  (is (= :hold (:disposition (phase/gate 3 {:op :account/intake} :hold)))))

(deftest gate-escalates-a-clean-non-auto-write
  (is (= :escalate (:disposition (phase/gate 3 {:op :actuation/execute-payment} :commit)))))

(deftest gate-holds-a-write-disabled-in-this-phase
  (is (= :hold (:disposition (phase/gate 0 {:op :account/intake} :commit)))))

(deftest phase-2-enables-consent-writes-but-not-auto
  (is (contains? (:writes (get phase/phases 2)) :consent/register-pis))
  (is (contains? (:writes (get phase/phases 2)) :consent/register-ais))
  (is (not (contains? (:auto (get phase/phases 2)) :consent/register-pis))))
